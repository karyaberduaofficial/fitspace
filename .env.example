# =============================================================================
# FitSpace PWA — Environment Template (Production & Local Development)
# Salin menjadi .env untuk lingkungan lokal atau atur di Secret Manager hosting.
# DILARANG KERAS menaruh kunci asli / API key produksi di file ini atau di Git.
# =============================================================================

APP_NAME="FitSpace PWA"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# Demo quick-login helper (HARUS false di produksi!)
FITSPACE_DEMO_MODE=false
FITSPACE_RESCHEDULE_CUTOFF_HOURS=8
FITSPACE_MAX_RESCHEDULE_COUNT=1

# Database (MySQL 8 untuk produksi, atau sqlite untuk uji lokal/CI)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitspace_pwa
DB_USERNAME=fitspace_user
DB_PASSWORD=

# Session, Cache & Queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# Payment Gateway — Midtrans (Isi via Secret Manager, JANGAN commit nilai asli)
PAYMENT_DEFAULT_GATEWAY=midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# Payment Gateway — Xendit (Isi via Secret Manager, JANGAN commit nilai asli)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Keamanan QR Code Kehadiran (Wajib 32+ karakter acak di produksi)
QR_SIGNING_SECRET=

# Google OAuth 2.0 Sign-In (Isi via Google Cloud Console / Secret Manager)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# Web Push Notification (VAPID Keys — isi via Secret Manager)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mail & Notifikasi
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@fitspace.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Logging & Keamanan
LOG_CHANNEL=stack
LOG_LEVEL=info
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
